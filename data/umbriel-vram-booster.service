[Unit]
Description=Umbriel VRAM Booster - dynamic dmem cgroup prioritization for the focused app
After=dmemcg-booster.service
Wants=dmemcg-booster.service

[Service]
Type=dbus
BusName=org.umbriel.VramBooster
ExecStart=/usr/bin/umbriel-vram-booster
Environment=RUST_LOG=warn
# Environment=VRAM_BOOST_RATIO=0.90  # uncomment to override (above 0, up to 1)
# Environment=VRAM_RESERVE_MIB=256    # VRAM app.slice may not take; 0 turns the ceiling off

Restart=on-failure
RestartSec=3
# 78 (EX_CONFIG) is a setting that is wrong, such as VRAM_BOOST_RATIO;
# restarting with it cannot help.
RestartPreventExitStatus=78

# Hardening. Runs as the session user (not root); dmem.low and dmem.max files
# under this user's user@<uid>.service subtree are user-owned, so no
# capabilities are needed to write them. Must preserve: reading
# /proc/<pid>/cgroup, /proc/<pid>/task/*/children and /proc/<pid>/environ,
# writing /sys/fs/cgroup/**/dmem.low and app.slice/dmem.max, and connecting
# to the Umbriel IPC socket under $XDG_RUNTIME_DIR (AF_UNIX).
#
# Deliberately NOT set:
#   ProtectControlGroups=true  -> /sys/fs/cgroup read-only, kills dmem.low writes
#   ProtectKernelTunables=true -> /sys read-only, breaks dmem.low writes
#   ProtectProc=invisible      -> system services only, ignored in a user manager
#   ProtectHome=true           -> empties /run/user as well as /home, which
#                                 hides both the session bus and the Umbriel
#                                 socket; the daemon cannot start with it
#   IPAddressDeny=any          -> needs root, a user manager ignores it with a
#                                 warning; RestrictAddressFamilies=AF_UNIX
#                                 already keeps the daemon off IP
# ReadWritePaths stays the whole cgroup tree: the daemon itself refuses any
# cgroup outside this user's own user-<uid>.slice.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/sys/fs/cgroup
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=default.target
